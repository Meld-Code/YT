{
  "manifest_version": 3,
  "name": "My Side Panel",
  "version": "1.0.0",
  "description": "A simple side panel extension.",
  "permissions": ["sidePanel"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open side panel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
